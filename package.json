{
	"name": "@synthlabs/utils",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.23.0",
	"scripts": {
		"check": "tsc -p js/translate/tsconfig.json && tsc -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . && prettier --check .",
		"test:unit": "vitest run --config vitest.config.ts && node --test \"js/**/*.test.mjs\"",
		"test:scripts": "node --test \"scripts/*.test.mjs\"",
		"test:rust": "node scripts/cargo-each.mjs test --locked",
		"test:go": "go test -C go ./...",
		"test:packaging": "node packaging/tauri/test.mjs",
		"test:packaging:aur": "bash packaging/tauri/aur/container-ssh.test.sh",
		"test:translate": "node scripts/check-translate.mjs",
		"test:translate:tauri": "node scripts/check-translate-tauri.mjs",
		"test:translate:ui": "node scripts/check-translate-ui.mjs",
		"lint:rust": "node scripts/cargo-each.mjs fmt --all -- --check && node scripts/cargo-each.mjs clippy --locked --all-targets -- -D warnings",
		"test": "pnpm test:unit && pnpm test:scripts && pnpm test:rust && pnpm test:go && pnpm test:packaging",
		"verify": "pnpm check && pnpm lint && pnpm test && pnpm lint:rust && git diff --check"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.77.0",
		"@playwright/test": "1.65.1",
		"@sveltejs/vite-plugin-svelte": "7.3.2",
		"@tauri-apps/api": "2.12.5",
		"@tauri-apps/plugin-log": "^2.10.2",
		"@tauri-apps/plugin-opener": "^2.7.3",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.14.1",
		"@types/node": "26.6.6",
		"clsx": "^2.1.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "31.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.1",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "8.3.8",
		"vitest": "5.1.1",
		"yaml": "2.9.1"
	}
}
